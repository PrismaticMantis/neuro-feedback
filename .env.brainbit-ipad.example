# BrainBit iPad MVP
#
# Browser dev: copy to .env.local
# Capacitor build: used automatically via `vite build --mode brainbit-ipad` (.env.brainbit-ipad)
VITE_BRAINBIT_IPAD_MVP=true
VITE_ENABLE_BRAINBIT_BRIDGE_EEG_DEVICE=true
VITE_EEG_DEVICE_KIND=brainbit_bridge

# --- Emailing the take-home session summary (optional but recommended for events) ---
# Set to true to auto-send via the Resend backend (api/send-report.ts).
# If false/unset, the app falls back to opening the Mail app (mailto).
VITE_ENABLE_EMAIL_REPORTS=true
# IMPORTANT: must be an ABSOLUTE URL — the Capacitor WebView can't resolve "/api/...".
# Point this at your deployed Vercel function.
VITE_REPORTS_API_URL=https://YOUR-APP.vercel.app/api/send-report
#
# Backend (set in Vercel project env, NOT here — these are secrets):
#   RESEND_API_KEY=re_xxxxxxxx
#   RESEND_FROM_EMAIL=NeuroFlo <noreply@yourdomain.com>
