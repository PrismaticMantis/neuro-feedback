# Vite mode: brainbit-ipad (Capacitor iOS shell build)
VITE_BRAINBIT_IPAD_MVP=true
VITE_ENABLE_BRAINBIT_BRIDGE_EEG_DEVICE=true
VITE_EEG_DEVICE_KIND=brainbit_bridge
VITE_DEBUG_BRAINBIT_BRIDGE=true

# Email the session summary to guests (Resend backend).
# The Capacitor WebView cannot use a relative "/api/..." URL, so this must be
# the ABSOLUTE URL of the deployed Vercel function.
VITE_ENABLE_EMAIL_REPORTS=true
VITE_REPORTS_API_URL=https://YOUR-APP.vercel.app/api/send-report
