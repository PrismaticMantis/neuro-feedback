{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Neuro Feedback",
  "version": "0.0.0",
  "identifier": "com.neurofeedback.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Neuro Feedback",
        "width": 1200,
        "height": 820,
        "minWidth": 900,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
